# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
API_PORT=4000
HOST=127.0.0.1

# postgres://hydris_app:...@host:5432/hydris for a real server (connect as a NON-owner role so RLS applies),
# or a local directory path for embedded PGlite (development), or memory:// for tests.
DATABASE_URL=./data/pglite

# 64 random hex chars each:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
DATA_KEY=

# Public origin of the web app (used in invitation, reset and pairing links)
PUBLIC_APP_URL=http://localhost:3000
STORAGE_DIR=./data/files
# Demo-tenant simulator (never affects customer tenants)
SIMULATOR_ENABLED=true

# Bootstrap accounts for `npm run seed` / `npm run seed:demo` (12+ characters)
SEED_ADMIN_EMAIL=admin@hydris.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ---- Realtime / serverless (see docs/operations/vercel.md) ----
# memory = in-process event bus (single long-running API, default). db = realtime_events table
# (required on Vercel / any multi-instance or serverless deployment).
REALTIME_MODE=memory
# SERVERLESS=1 disables timer-driven engines (auto-detected on Vercel via VERCEL=1); jobs then run via /api/cron.
# SERVERLESS=
# Vercel Blob private store token (auto-injected when a Blob store is connected). Empty = local disk (STORAGE_DIR).
BLOB_READ_WRITE_TOKEN=
# Secret for the /api/cron endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Set to false when migrations run in the build step (npm run vercel-build) instead of on cold start.
# MIGRATE_ON_START=true
