<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.Hydris" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/midnight</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <!-- Android 12+ splash: the favicon mark on its Core Blue disc, over Deep Midnight (the web's canvas). -->
    <item name="android:windowSplashScreenBackground">@color/midnight</item>
    <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
  </style>
</resources>
