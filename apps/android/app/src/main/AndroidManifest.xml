<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Meta Wearables DAT: Bluetooth link to the glasses through the Meta AI app -->
  <uses-permission android:name="android.permission.BLUETOOTH" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Phone camera fallback for audit scans; phone microphone fallback for "Hey Hydris" -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />

  <queries>
    <package android:name="com.facebook.stella" /> <!-- Meta AI app (glasses pairing, DAT registration) -->
    <intent><action android:name="android.speech.RecognitionService" /></intent>
    <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
  </queries>

  <application
      android:name=".HydrisApp"
      android:label="Hydris Field"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:theme="@style/Theme.Hydris">
    <meta-data android:name="com.meta.wearable.mwdat.APPLICATION_ID" android:value="${mwdat_application_id}" />
    <meta-data android:name="com.meta.wearable.mwdat.CLIENT_TOKEN" android:value="${mwdat_client_token}" />
    <!-- ML Kit: download the Latin text model at install time -->
    <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr" />

    <!-- Captures gallery: share photos from app storage -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.captures"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/capture_paths" />
    </provider>

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTop"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Hydris">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Callback from the Meta AI app after registration / permission prompts -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.BROWSABLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="hydrisfield" />
      </intent-filter>
    </activity>
  </application>
</manifest>
