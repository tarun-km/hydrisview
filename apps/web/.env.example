# Vercel project environment variables (web app)
# Public base URL of the Hydris API service (no trailing slash). All /api/* requests are proxied here,
# keeping auth cookies first-party on the Vercel domain.
API_URL=https://hydris-api.onrender.com
# Public URL of this web app (used for metadata)
PUBLIC_APP_URL=https://your-project.vercel.app
