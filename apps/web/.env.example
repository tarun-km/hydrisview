# Vercel project environment variables. Pick ONE mode.

# ===== Mode A: everything on Vercel (built-in API; docs/operations/vercel.md) =====
# Leave API_URL unset: /api/* is served by the Next.js route handlers in this project.
# Neon via Vercel Marketplace injects DATABASE_URL (use the POOLED connection string, sslmode=require).
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# 64 hex chars each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
DATA_KEY=
CRON_SECRET=
NODE_ENV=production
PUBLIC_APP_URL=https://your-project.vercel.app
REALTIME_MODE=db
# Injected automatically when a Vercel Blob store (private) is connected to the project.
BLOB_READ_WRITE_TOKEN=
# Demo simulator (demo tenant only); steps advance once per cron run on Vercel.
SIMULATOR_ENABLED=false
# Optional: MIGRATE_ON_START=false if you run migrations in the build (npm run vercel-build).
# Seeding is done from your machine, not on Vercel: SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD / SEED_DEMO_PASSWORD

# ===== Mode B: web on Vercel, API on a container host (docs/operations/deployment.md) =====
# Public base URL of the Hydris API service (no trailing slash). All /api/* requests are proxied here,
# keeping auth cookies first-party on the Vercel domain. Setting this disables the built-in API.
# API_URL=https://hydris-api.onrender.com
# PUBLIC_APP_URL=https://your-project.vercel.app
